{
  "builds": [
    {
      "src": "api/ensaio-partilha.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["ensaios/*", "editorial-preview.js", "whatsapp-editorial.js", "rotina.css"]
      }
    }
  ],
  "routes": [
    { "src": "^/(?:ensaio-partilha/?)?$", "dest": "/api/ensaio-partilha.js" },
    {
      "src": "^/ensaio-partilha/(editorial-preview\\.js|whatsapp-editorial\\.js|rotina\\.css|ensaio\\.css|guia\\.js)$",
      "dest": "/api/ensaio-partilha.js?recurso=$1"
    },
    {
      "src": "^/api/stock$",
      "has": [
        { "type": "query", "key": "integration", "value": "editorial-image" },
        { "type": "query", "key": "date", "value": "2099-01-01" },
        { "type": "query", "key": "slide", "value": "1" },
        { "type": "query", "key": "v", "value": "v4" },
        { "type": "query", "key": "variant", "value": "wa1" }
      ],
      "dest": "/api/ensaio-partilha.js?recurso=amostra.jpg"
    },
    { "src": "^/.*$", "status": 404 }
  ]
}
