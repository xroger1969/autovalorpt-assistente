{
  "cleanUrls": false,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/instagram-agent-sync", "schedule": "17 8 * * *" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat-smart" },
    { "src": "/api/archive-retoma", "dest": "/api/archive-retomas?action=open" },
    { "src": "/api/archive-retoma-delete", "dest": "/api/archive-retomas?action=delete" },
    { "src": "/api/instagram-agent-drafts", "dest": "/api/admin-retomas?instagramAction=drafts" },
    { "src": "/api/instagram-agent-sync", "dest": "/api/admin-retomas?instagramAction=sync" },
    { "src": "/api/instagram-agent-action", "dest": "/api/admin-retomas?instagramAction=action" },
    { "src": "/api/instagram-agent-media", "dest": "/api/admin-retomas?instagramAction=media" },
    { "src": "/", "dest": "/welcome.html" }
  ],
  "headers": [
    {
      "source": "/fotos.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow,noarchive" }
      ]
    },
    {
      "source": "/arquivo-retomas.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/retomas.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https://*.private.blob.vercel-storage.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/instagram-agent.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https://*.private.blob.vercel-storage.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
